---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const grades = [
  ['Α΄','Πρώτα βήματα στον υπολογιστή',`${base}taxeis/`],
  ['Β΄','Δημιουργώ και ακολουθώ οδηγίες',`${base}taxeis/`],
  ['Γ΄','Οργανώνω, γράφω και προγραμματίζω',`${base}taxeis/g/`],
  ['Δ΄','Εμβαθύνω σε εργαλεία και αλγορίθμους',`${base}taxeis/`],
  ['Ε΄','Δημιουργώ ψηφιακά και σκέφτομαι υπολογιστικά',`${base}taxeis/`],
  ['ΣΤ΄','Συνθέτω, προγραμματίζω και αξιολογώ ψηφιακά',`${base}taxeis/`]
];
const topics = [
  ['💻','Υπολογιστής & συσκευές'],['⌨️','Πληκτρολόγηση'],['🎨','Ψηφιακή δημιουργία'],
  ['🌐','Διαδίκτυο'],['🛡️','Ψηφιακή ασφάλεια'],['🧠','Υπολογιστική σκέψη'],
  ['🧩','Προγραμματισμός'],['🤖','Ρομποτική'],['✨','Τεχνητή Νοημοσύνη']
];
---
<BaseLayout>
  <section class="hero">
    <div class="eyebrow">ΤΠΕ στο Δημοτικό</div>
    <h1>Μαθαίνω τεχνολογία μέσα από ψηφιακές διαδρομές.</h1>
    <p>Ένα οργανωμένο περιβάλλον για δραστηριότητες, προγραμματισμό, ψηφιακή δημιουργία, ασφάλεια στο Διαδίκτυο, quizzes και projects από την Α΄ έως τη ΣΤ΄ Δημοτικού.</p>
  </section>

  <section class="section">
    <h2>Διάλεξε την τάξη σου</h2>
    <p class="section-intro">Κάθε τάξη ακολουθεί τη δική της μαθησιακή πορεία, με σταδιακή αύξηση δυσκολίας και σύνδεση με προηγούμενες γνώσεις.</p>
    <div class="grid">
      {grades.map(([grade,desc,href]) => (
        <a class="card grade-card" href={href}>
          <div class="grade-letter">{grade}</div>
          <h3>Δημοτικού</h3>
          <p>{desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Εξερεύνησε ανά θεματική</h2>
    <p class="section-intro">Ο ίδιος μαθησιακός χάρτης μπορεί να εξερευνηθεί και οριζόντια, ανά γνωστικό αντικείμενο.</p>
    <div class="grid">
      {topics.map(([icon,title]) => (
        <a class="card" href={`${base}thematikes/`}>
          <div class="icon">{icon}</div>
          <h3>{title}</h3>
          <p>Δραστηριότητες από διαφορετικές τάξεις με κοινό γνωστικό στόχο.</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
