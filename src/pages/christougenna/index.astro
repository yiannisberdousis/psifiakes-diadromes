      { title: 'Η πτήση του Άγιου Βασίλη', url: 'http://www.akidsheart.com/holidays/christms/cflight/cflight.html' },
      { title: 'Χριστουγεννιάτικη γιρλάντα', url: 'http://www.akidsheart.com/holidays/christms/ornwell/ornwell.html' },
    ],
  },
  {
    title: 'Ζωγραφίζω και φτιάχνω κάρτες',
    items: [
      { title: 'Χρωματίζω χριστουγεννιάτικα σκίτσα', url: 'https://www.online-coloring.com/1-printables-christmas/' },
      { title: 'Δημιουργώ χριστουγεννιάτικη κάρτα', url: 'https://www.greetingsisland.com/cards/holidays/christmas' },
      { title: 'Χριστουγεννιάτικη κάρτα στο Canva', url: 'https://www.canva.com/design/DAG77lFvIBc/c8J2oJ8DfuEOKt20FHhyiw/view?embed', embed: true },
      { title: 'Άνοιγμα της κάρτας στο Canva', url: 'https://www.canva.com/design/DAG77lFvIBc/RQ_SNevIqA8mvv8h1Yivyg/edit' },
    ],
  },
  {
    title: 'Scratch και Pixel Art',
    items: [
      { title: 'Χριστουγεννιάτικα έργα Scratch', url: 'https://scratch.mit.edu/studios/35755498' },
      { title: 'Χριστουγεννιάτικο Pixel Art', url: 'https://drive.google.com/drive/folders/1ujw2MXcMhi8gQkwcyqDlfa3FoqeVr9qm?usp=sharing' },
      { title: 'Φύλλο Pixel Art 1', url: 'https://drive.google.com/file/d/16CbwPxAf7yyTkSe1uYbK14ZCtLTmBMMN/preview' },
      { title: 'Φύλλο Pixel Art 2', url: 'https://drive.google.com/file/d/1yfrjz21uikYAFDZsfPthVPEbpsJRMIit/preview' },
    ],
