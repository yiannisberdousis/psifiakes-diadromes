    ],
  },
  {
    title: 'Στολίζω και παίζω',
    items: [
      { title: 'Στόλισε το δέντρο', url: 'https://www.topmarks.co.uk/christmas/decorate-tree' },
      ...['5fd949ba4779fa0d375f2ab7', '5fbe420a1670610d0dfcee3e', '5fdc5d92ed7e540d00a28ebf', '693e75ae9463b4ac0880579c'].map((id, index) => ({
        title: `Στολισμός δέντρου · Δραστηριότητα ${index + 1}`,
        url: `https://view.genial.ly/${id}`,
