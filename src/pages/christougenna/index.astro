  ['Μετράω και απαντάω', 'eb854c7772244d07aa4cf4b94931e3a6', 1, 5],
  ['Χριστουγεννιάτικη αντιστοίχιση', '9ab04362d0564a4eb08d2dda7f457c00', 1, 2],
  ['Χριστούγεννα · Παιχνίδι 3', '95b04a5b97ce4115bca170738a86a960', 1, 22],
  ['Χριστούγεννα · Παιχνίδι 4', '1dd27415785a4b7b8527280ea9e0ed9a', 1, 3],
  ['Χριστούγεννα · Κουίζ 1', '4aef04b1c34a4c06a2b9d269955164c6', 1, 5],
  ['Χριστούγεννα · Κουίζ 2', '2e68c8246c6947cea48142ae01901984', 54, 5],
  ['Χριστούγεννα · Κουίζ 3', '90abb548385b4355917c069be12a0ede', 54, 5],
  ['Χριστούγεννα · Παιχνίδι 5', 'ab5926cebfc94cae965b0945d6b73268', 6, 30],
  ['Χριστούγεννα · Κουίζ 4', '8a3c748a26eb47ff99199b9be4365e39', 6, 5],
  ['Χριστούγεννα · Κουίζ 5', '95b8934bebb741f3886d1b2c63323f93', 1, 5],
