---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const units = [
  ['1','Γνωρίζω τον υπολογιστή','Υλικό, λογισμικό, περιφερειακές συσκευές και σωστή χρήση.','💻',`${base}taxeis/g/ypologistis/`],
  ['2','Αρχεία και φάκελοι','Δημιουργώ, οργανώνω, αποθηκεύω και βρίσκω τα αρχεία μου.','📁','#'],
  ['3','Δημιουργώ κείμενο','Γράφω, διορθώνω και μορφοποιώ ένα μικρό ψηφιακό κείμενο.','📝','#'],
  ['4','Δημιουργώ παρουσίαση','Συνδυάζω τίτλους, εικόνες και σύντομα κείμενα σε διαφάνειες.','📽️','#'],
  ['5','Μπαίνω στο Διαδίκτυο με ασφάλεια','Περιηγούμαι, αναζητώ και προστατεύω τα προσωπικά μου δεδομένα.','🌐','#'],
  ['6','Προγραμματίζω με μπλοκ','Ακολουθίες, γεγονότα, επανάληψη και μικρά projects.','🧩','#']
];
---
<BaseLayout title="Γ΄ Δημοτικού | Ψηφιακές Διαδρομές">
  <section class="hero compact-hero">
    <div class="eyebrow">Γ΄ Δημοτικού</div>
    <h1>Οργανώνω, δημιουργώ και προγραμματίζω.</h1>
    <p>Έξι οργανωμένες μαθησιακές διαδρομές που χτίζουν βασικές ψηφιακές δεξιότητες και εισάγουν σταδιακά τον προγραμματισμό.</p>
  </section>
  <section class="section">
    <h2>Οι ενότητες της Γ΄ τάξης</h2>
    <p class="section-intro">Προχωράμε από τη γνωριμία με το ψηφιακό σύστημα στην παραγωγή περιεχομένου, την ασφάλεια και τον προγραμματισμό.</p>
    <div class="grid">
      {units.map(([n,title,desc,icon,href]) => (
        <a class="card" href={href}>
          <div class="unit-index">Ενότητα {n}</div>
          <div class="icon">{icon}</div>
          <h3>{title}</h3>
          <p>{desc}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
