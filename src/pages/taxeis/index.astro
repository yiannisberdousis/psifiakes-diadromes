---
import BaseLayout from '../../layouts/BaseLayout.astro';
const grades = [
  ['Α΄ Δημοτικού','Γνωριμία με το εργαστήριο, χειρισμός ποντικιού και πληκτρολογίου, ψηφιακή ζωγραφική και πρώτες ακολουθίες.'],
  ['Β΄ Δημοτικού','Δημιουργία ψηφιακού περιεχομένου, βασική πληκτρολόγηση, ακολουθίες και απλές δραστηριότητες προγραμματισμού.'],
  ['Γ΄ Δημοτικού','Υπολογιστής, αρχεία και φάκελοι, κείμενο, Διαδίκτυο, ψηφιακή ασφάλεια και προγραμματισμός.'],
  ['Δ΄ Δημοτικού','Παραγωγικότητα, πολυμέσα, ασφαλής χρήση Διαδικτύου, αλγόριθμοι και visual programming.'],
  ['Ε΄ Δημοτικού','Παρουσιάσεις, δεδομένα, δημιουργικά projects, υπολογιστική σκέψη και προγραμματισμός.'],
  ['ΣΤ΄ Δημοτικού','Σύνθετα projects, κριτική ψηφιακή παιδεία, προγραμματισμός, ρομποτική και Τεχνητή Νοημοσύνη.']
];
---
<BaseLayout title="Τάξεις | Ψηφιακές Διαδρομές">
  <section class="section">
    <div class="eyebrow">Μαθησιακές διαδρομές</div>
    <h1>Α΄ έως ΣΤ΄ Δημοτικού</h1>
    <p class="section-intro">Η ύλη οργανώνεται ανά τάξη ώστε κάθε μαθητής να βλέπει καθαρά τι έχει προηγηθεί, τι μαθαίνει τώρα και ποιο είναι το επόμενο βήμα.</p>
    <div class="grid">
      {grades.map(([title,desc]) => <article class="card"><h3>{title}</h3><p>{desc}</p><div class="tag-row"><span class="tag">Υπό σχεδιασμό</span></div></article>)}
    </div>
  </section>
</BaseLayout>
