---
import '../styles/global.css';
const { title = 'Ψηφιακές Διαδρομές', description = 'Μαθησιακές διαδρομές ΤΠΕ για το Δημοτικό' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>Ψηφιακές Διαδρομές</a>
      <nav>
        <a href={`${base}taxeis/`}>Τάξεις</a>
        <a href={`${base}thematikes/`}>Θεματικές</a>
        <a href={`${base}quizzes/`}>Quizzes</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Ψηφιακές Διαδρομές · ΤΠΕ στο Δημοτικό</p>
    </footer>
  </body>
</html>
